{
  "name": "digimandal-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for DigiMandal app",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "superadmin:grant": "node scripts/grant-super-admin.js",
    "banks:sync": "node scripts/sync-banks.js",
    "test": "node --test tests/home/core.test.js tests/issues/core.test.js tests/issues/contract.test.js",
    "test:home:integration": "node --test tests/home/integration.test.js",
    "home:worker": "node scripts/home-worker.js",
    "home:load": "node scripts/home-load.js",
    "home:explain": "node scripts/home-explain.js",
    "home:contracts": "node scripts/home-contracts.js",
    "test:home:contract": "node --test tests/home/contract.test.js",
    "test:issues": "node --test tests/issues/core.test.js tests/issues/contract.test.js",
    "test:issues:integration": "node scripts/issues-test-db.js",
    "issues:cleanup": "node scripts/issues-cleanup.js",
    "issues:openapi": "node scripts/issues-openapi.js",
    "lint:issues": "eslint --config eslint.issues.config.js src/issues tests/issues scripts/issues-*.js",
    "typecheck:issues": "tsc -p tsconfig.issues.json",
    "format:issues": "prettier --write src/issues tests/issues/*.js scripts/issues-*.js eslint.issues.config.js tsconfig.issues.json docs/issues/*.md",
    "format:issues:check": "prettier --check src/issues tests/issues/*.js scripts/issues-*.js eslint.issues.config.js tsconfig.issues.json docs/issues/*.md"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.10",
    "prisma": "^5.10.2",
    "typescript": "^5.9.3",
    "ajv": "^8.18.0"
  }
}
