            },
            "url": {
              "raw": "{{base_url}}/roles/{{mandal_id}}/members/{{member_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "roles",
                "{{mandal_id}}",
                "members",
                "{{member_id}}"
              ]
            }
