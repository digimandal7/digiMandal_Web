    {
      "name": "1 - Mandal Details",
      "item": [
        {
          "name": "Create Registered Mandal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.data?.id) pm.collectionVariables.set('mandal_id', json.data.id);"
                ],
                "type": "text/javascript"
