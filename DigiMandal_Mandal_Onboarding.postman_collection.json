{
  "info": {
    "name": "DigiMandal - Mandal Onboarding",
    "description": "Four-step registered Mandal workflow. Run authentication first and set token. File requests require selecting local files in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "0 - Dropdown Data",
      "item": [
        { "name": "Get Mandal Options", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/catalog/mandal-options" } }
      ]
    },
    {
      "name": "1 - Mandal Details",
      "item": [
        {
          "name": "Create Registered Mandal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ekta Mandal\",\n  \"category\": \"Cultural\",\n  \"size\": \"51-200\",\n  \"formationYear\": 2020,\n  \"isPrivate\": false,\n  \"isRegistered\": true\n}" },
            "url": "{{base_url}}/mandal"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('mandal_id', json.data.id);"] } }]
        },
        { "name": "Get Draft", "request": { "method": "GET", "url": "{{base_url}}/mandal/{{mandal_id}}" } }
      ]
    },
    {
      "name": "2 - Mandal Address",
      "item": [
        {
          "name": "Save Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressLine1\": \"Om Sai Krupa CHS, Khewra Circle Road\",\n  \"addressLine2\": \"Near Pokharan Road No. 2\",\n  \"pincode\": \"400610\",\n  \"city\": \"Thane\",\n  \"state\": \"Maharashtra\",\n  \"latitude\": \"19.2183\",\n  \"longitude\": \"72.9781\",\n  \"placeId\": \"sample-google-place-id\",\n  \"formattedAddress\": \"Om Sai Krupa CHS, Thane West, Maharashtra 400610\"\n}" },
            "url": "{{base_url}}/mandal/{{mandal_id}}/address"
          }
        }
      ]
    },
    {
      "name": "3 - Invite Core Members",
      "item": [
        {
          "name": "Bulk Invite Five Members",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"members\": [\n    { \"name\": \"Omkar Chougule\", \"mobile\": \"+919283432647\", \"role\": \"Manager\" },\n    { \"name\": \"Sofia Martinez\", \"mobile\": \"+918275642381\", \"role\": \"Member\" },\n    { \"name\": \"Rajesh Kumar\", \"mobile\": \"9812345678\", \"role\": \"Member\" },\n    { \"name\": \"Emily Johnson\", \"mobile\": \"7432109876\", \"role\": \"Member\" },\n    { \"name\": \"Michael Smith\", \"mobile\": \"5647382910\", \"role\": \"Member\" }\n  ]\n}" },
            "url": "{{base_url}}/invitation/{{mandal_id}}/bulk"
          }
        },
        { "name": "Invitation Status", "request": { "method": "GET", "url": "{{base_url}}/invitation/{{mandal_id}}/list" } }
      ]
    },
    {
      "name": "4 - Registration and Documents",
      "item": [
        {
          "name": "Save Registration Details",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"registrationDate\": \"2020-01-15\",\n  \"panNumber\": \"AAAPA1234A\",\n  \"organizationAddress\": \"Thane West, Maharashtra 400610\"\n}" },
            "url": "{{base_url}}/mandal/{{mandal_id}}/registration"
          }
        },
        {
          "name": "Upload Registration Certificate",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "mandalId", "value": "{{mandal_id}}", "type": "text" }, { "key": "type", "value": "REGISTRATION_CERTIFICATE", "type": "text" }, { "key": "file", "type": "file", "src": "" }] },
            "url": "{{base_url}}/documents/upload"
          }
        },
        {
          "name": "Upload 80G Certificate",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "mandalId", "value": "{{mandal_id}}", "type": "text" }, { "key": "type", "value": "80G_CERTIFICATE", "type": "text" }, { "key": "file", "type": "file", "src": "" }] },
            "url": "{{base_url}}/documents/upload"
          }
        }
      ]
    },
    {
      "name": "5 - Bank Details",
      "item": [
        {
          "name": "Save Bank Details",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bankName\": \"HDFC Bank\",\n  \"accountName\": \"Ekta Mandal\",\n  \"accountNumber\": \"123456789012\",\n  \"confirmAccountNumber\": \"123456789012\",\n  \"ifscCode\": \"HDFC0000123\"\n}" },
            "url": "{{base_url}}/mandal/{{mandal_id}}/bank-details"
          }
        },
        {
          "name": "Upload Cancelled Cheque",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "mandalId", "value": "{{mandal_id}}", "type": "text" }, { "key": "type", "value": "CANCELLED_CHEQUE", "type": "text" }, { "key": "file", "type": "file", "src": "" }] },
            "url": "{{base_url}}/documents/upload"
          }
        },
        { "name": "Skip Bank Instead", "request": { "method": "POST", "url": "{{base_url}}/mandal/{{mandal_id}}/bank-details/skip" } }
      ]
    },
    {
      "name": "6 - Finalize",
      "item": [
        { "name": "Check Onboarding Status", "request": { "method": "GET", "url": "{{base_url}}/mandal/{{mandal_id}}/onboarding-status" } },
        { "name": "Finalize and Activate Mandal", "request": { "method": "POST", "url": "{{base_url}}/mandal/{{mandal_id}}/finalize" } }
      ]
    },
    {
      "name": "7 - Roles and Permissions",
      "item": [
        { "name": "Permission Catalogue", "request": { "method": "GET", "url": "{{base_url}}/roles/permissions" } },
        {
          "name": "List Mandal Roles",
          "request": { "method": "GET", "url": "{{base_url}}/roles/{{mandal_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const manager = json.data?.find(role => role.name === 'Manager');", "const member = json.data?.find(role => role.name === 'Member');", "if (manager) pm.collectionVariables.set('manager_role_id', manager.id);", "if (member) pm.collectionVariables.set('member_role_id', member.id);"] } }]
        },
        {
          "name": "Create Custom Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Event Coordinator\",\n  \"description\": \"Can manage members and documents for events\",\n  \"permissions\": [\"VIEW_MANDAL\", \"VIEW_MEMBERS\", \"MANAGE_MEMBERS\", \"VIEW_DOCUMENTS\"]\n}" },
            "url": "{{base_url}}/roles/{{mandal_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('custom_role_id', json.data.id);"] } }]
        },
        {
          "name": "Update Custom Role Permissions",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"permissions\": [\"VIEW_MANDAL\", \"VIEW_MEMBERS\", \"MANAGE_MEMBERS\", \"VIEW_DOCUMENTS\", \"MANAGE_DOCUMENTS\"]\n}" },
            "url": "{{base_url}}/roles/{{mandal_id}}/{{custom_role_id}}"
          }
        },
        { "name": "Assign Role to Member", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"roleId\": {{custom_role_id}}\n}" }, "url": "{{base_url}}/roles/{{mandal_id}}/members/{{member_id}}" } },
        { "name": "Delete Custom Role", "request": { "method": "DELETE", "url": "{{base_url}}/roles/{{mandal_id}}/{{custom_role_id}}" } }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "mandal_id", "value": "" },
    { "key": "member_id", "value": "" },
    { "key": "manager_role_id", "value": "" },
    { "key": "member_role_id", "value": "" },
    { "key": "custom_role_id", "value": "" }
  ]
}
