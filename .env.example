
PORT=3000
DATABASE_URL="mysql://user:password@localhost:3306/digimandal"
JWT_SECRET="super-secret-key"
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
OTP_BLOCK_MINUTES=30
EXPOSE_OTP=true
NODE_ENV=development
# Optional separate secret; otherwise JWT_SECRET signs Home cursors.
# HOME_CURSOR_SECRET=use-a-long-random-secret
# MySQL production URL should include ?connection_limit=10&pool_timeout=3&connect_timeout=3
# Ranking overrides: numeric 0..100; diversity is an integer 1..100.
HOME_RANK_RECENCY=10
HOME_RANK_LOCAL=6
HOME_RANK_RELATIONSHIP=8
HOME_RANK_ENGAGEMENT=2
HOME_RANK_URGENCY=3
HOME_RANK_DIVERSITY=2
BANK_SYNC_ENABLED=true
BANK_SYNC_INTERVAL_HOURS=24
BANK_SYNC_SOURCE_URL=https://raw.githubusercontent.com/razorpay/ifsc/master/src/banknames.json

# Per issue/comment/resolution (1-50); images are limited to 5 MiB each.
ISSUE_MAX_ATTACHMENTS=10
