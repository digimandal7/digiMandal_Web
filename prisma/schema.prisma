// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MandalStatus {
  DRAFT
  INVITED
  INVITATIONS_SENT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              Int     @id @default(autoincrement())
  mobile          String  @unique @db.VarChar(10)
  password        String? // Only for registered users
  isVerified      Boolean @default(false)
  profileComplete Boolean @default(false)

  // Profile fields
  name              String?
  email             String?   @unique
  profileImage      String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  interestIds       String?   @db.Text // JSON array of interest IDs
  preferredLanguage String    @default("en") @db.VarChar(5)
  blockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  mandalsOwned       Mandal[]                @relation("OwnerMandals")
  invitations        MandalInvitation[]
  memberships        MandalMember[]
  preferredLocations UserPreferredLocation[]

  @@index([mobile])
  @@index([email])
  @@index([createdAt])
}

model UserPreferredLocation {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String   @db.VarChar(255)
  formattedAddress String   @db.Text
  placeId          String?  @db.VarChar(255)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId, position])
}

model Mandal {
  id                 Int          @id @default(autoincrement())
  name               String       @db.VarChar(255)
  category           String       @db.VarChar(100)
  size               String       @default("Medium") @db.VarChar(50)
  formationYear      Int          @default(2025)
  isPrivate          Boolean      @default(false)
  isRegistered       Boolean      @default(false)
  onboardingStep     Int          @default(1)
  bankDetailsSkipped Boolean      @default(false)
  status             MandalStatus @default(DRAFT)
  description        String?      @db.Text
  finalizedAt        DateTime?
  rejectionReason    String?      @db.Text

  createdById Int
  createdBy   User @relation("OwnerMandals", fields: [createdById], references: [id])

  address      MandalAddress?
  registration MandalRegistration?
  bank         MandalBank?
  members      MandalMember[]
  invites      MandalInvitation[]
  documents    MandalDocument[]
  roles        MandalRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([createdById])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model MandalRole {
  id          Int      @id @default(autoincrement())
  mandalId    Int
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mandal      Mandal             @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  members     MandalMember[]
  invitations MandalInvitation[]

  @@unique([mandalId, name])
  @@index([mandalId])
}

model MandalAddress {
  id               Int     @id @default(autoincrement())
  mandalId         Int     @unique
  addressLine1     String  @db.VarChar(255)
  addressLine2     String? @db.VarChar(255)
  city             String  @db.VarChar(100)
  state            String  @db.VarChar(100)
  pincode          String  @db.VarChar(10)
  latitude         String?
  longitude        String?
  placeId          String? @db.VarChar(255)
  formattedAddress String? @db.Text

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalRegistration {
  id                  Int      @id @default(autoincrement())
  mandalId            Int      @unique
  panNumber           String   @db.VarChar(10)
  registrationDate    DateTime
  organizationAddress String   @db.Text

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalBank {
  id            Int    @id @default(autoincrement())
  mandalId      Int    @unique
  bankName      String @db.VarChar(100)
  accountName   String @db.VarChar(100)
  accountNumber String @db.VarChar(20)
  ifscCode      String @default("") @db.VarChar(11)

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalMember {
  id       Int      @id @default(autoincrement())
  mandalId Int
  userId   Int?
  mobile   String   @default("") @db.VarChar(10)
  role     String   @db.VarChar(100)
  roleId   Int?
  joinedAt DateTime @default(now())

  mandal  Mandal      @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleRef MandalRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([mandalId, userId])
  @@index([mandalId])
  @@index([userId])
  @@index([mobile])
  @@index([roleId])
}

model MandalInvitation {
  id          Int              @id @default(autoincrement())
  mandalId    Int
  userId      Int?
  mobile      String           @db.VarChar(10)
  role        String           @default("Member") @db.VarChar(100)
  roleId      Int?
  contactName String?          @db.VarChar(150)
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime?

  mandal  Mandal      @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef MandalRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([mandalId, mobile])
  @@index([mandalId])
  @@index([mobile])
  @@index([status])
  @@index([roleId])
}

model MandalDocument {
  id        Int      @id @default(autoincrement())
  mandalId  Int
  type      String   @db.VarChar(100)
  fileUrl   String   @db.Text
  fileId    String   @db.VarChar(255)
  createdAt DateTime @default(now())

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)

  @@index([mandalId])
  @@index([type])
}

model OTP {
  id          Int      @id @default(autoincrement())
  mobile      String   @db.VarChar(10)
  code        String   @db.VarChar(6)
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([mobile, code])
  @@index([mobile])
  @@index([expiresAt])
}

model Interest {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  @@index([name])
}
