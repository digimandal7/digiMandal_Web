// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum MasterOptionType {
  MANDAL_SIZE
  MANDAL_CATEGORY
  BANK
}

enum MandalStatus {
  DRAFT
  INVITED
  INVITATIONS_SENT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              Int     @id @default(autoincrement())
  mobile          String  @unique @db.VarChar(10)
  password        String? // Only for registered users
  isVerified      Boolean @default(false)
  profileComplete Boolean @default(false)

  // Profile fields
  name              String?
  email             String?   @unique
  profileImage      String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  interestIds       String?   @db.Text // JSON array of interest IDs
  preferredLanguage String    @default("en") @db.VarChar(5)
  blockedUntil      DateTime?
  platformRole      UserRole  @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  mandalsOwned       Mandal[]                @relation("OwnerMandals")
  invitations        MandalInvitation[]
  memberships        MandalMember[]
  preferredLocations UserPreferredLocation[]
  homeLocation       HomeLocation?
  homePosts          HomePost[]
  homeComments       HomeComment[]
  homeLikes          HomeLike[]
  homeSaves          HomeSave[]
  homeParticipants   HomeParticipant[]
  homeSeen           HomeStorySeen[]
  homeReports        HomeReport[]
  homeImpressions    HomeImpression[]
  homeSnapshots      HomeSnapshot[]
  homeFilters        HomeFilter[]            @relation("FilterOwner")
  homeFilteredBy     HomeFilter[]            @relation("FilterTarget")
  homeMedia          HomeMedia[]
  issues             Issue[]
  issueSupports      IssueSupporter[]
  issueComments      IssueComment[]
  issueResolutions   IssueResolution[]
  issueUploads       IssueUpload[]
  issueActivity      IssueActivity[]
  issueReads         IssueRead[]

  @@index([mobile])
  @@index([email])
  @@index([pincode])
  @@index([createdAt])
}

model MasterOption {
  id        Int              @id @default(autoincrement())
  type      MasterOptionType
  code      String           @db.VarChar(100)
  label     String           @db.VarChar(150)
  metadata  Json?
  isOther   Boolean          @default(false)
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([type, code])
  @@index([type, isActive, sortOrder])
}

model UserPreferredLocation {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String   @db.VarChar(255)
  formattedAddress String   @db.Text
  placeId          String?  @db.VarChar(255)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId, position])
}

model Mandal {
  id                 Int          @id @default(autoincrement())
  name               String       @db.VarChar(255)
  category           String       @db.VarChar(100)
  size               String       @default("Medium") @db.VarChar(50)
  formationYear      Int          @default(2025)
  isPrivate          Boolean      @default(false)
  isRegistered       Boolean      @default(false)
  onboardingStep     Int          @default(1)
  bankDetailsSkipped Boolean      @default(false)
  status             MandalStatus @default(DRAFT)
  description        String?      @db.Text
  finalizedAt        DateTime?
  rejectionReason    String?      @db.Text

  createdById Int
  createdBy   User @relation("OwnerMandals", fields: [createdById], references: [id])

  address      MandalAddress?
  registration MandalRegistration?
  bank         MandalBank?
  members      MandalMember[]
  invites      MandalInvitation[]
  documents    MandalDocument[]
  roles        MandalRole[]
  avatarUrl    String?             @db.Text
  homePosts    HomePost[]
  homeEvents   HomeEvent[]
  homeStories  HomeStory[]
  issues       Issue[]
  issueUploads IssueUpload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([createdById])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model MandalRole {
  id          Int      @id @default(autoincrement())
  mandalId    Int
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mandal      Mandal             @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  members     MandalMember[]
  invitations MandalInvitation[]

  @@unique([mandalId, name])
  @@index([mandalId])
}

model MandalAddress {
  id               Int     @id @default(autoincrement())
  mandalId         Int     @unique
  addressLine1     String  @db.VarChar(255)
  addressLine2     String? @db.VarChar(255)
  city             String  @db.VarChar(100)
  state            String  @db.VarChar(100)
  pincode          String  @db.VarChar(10)
  latitude         String?
  longitude        String?
  placeId          String? @db.VarChar(255)
  formattedAddress String? @db.Text

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalRegistration {
  id                  Int      @id @default(autoincrement())
  mandalId            Int      @unique
  panNumber           String   @db.VarChar(10)
  registrationDate    DateTime
  organizationAddress String   @db.Text

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalBank {
  id            Int    @id @default(autoincrement())
  mandalId      Int    @unique
  bankName      String @db.VarChar(100)
  accountName   String @db.VarChar(100)
  accountNumber String @db.VarChar(20)
  ifscCode      String @default("") @db.VarChar(11)

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model MandalMember {
  id                Int                @id @default(autoincrement())
  mandalId          Int
  userId            Int?
  mobile            String             @default("") @db.VarChar(10)
  role              String             @db.VarChar(100)
  roleId            Int?
  joinedAt          DateTime           @default(now())
  isActive          Boolean            @default(true)
  issueParticipants IssueParticipant[]

  mandal  Mandal      @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleRef MandalRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([mandalId, userId])
  @@index([mandalId])
  @@index([userId])
  @@index([mobile])
  @@index([roleId])
  @@index([userId, isActive, mandalId])
}

model MandalInvitation {
  id          Int              @id @default(autoincrement())
  mandalId    Int
  userId      Int?
  mobile      String           @db.VarChar(10)
  role        String           @default("Member") @db.VarChar(100)
  roleId      Int?
  name        String?          @db.VarChar(255)
  contactName String?          @db.VarChar(150)
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime?

  mandal  Mandal      @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef MandalRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([mandalId, mobile])
  @@index([mandalId])
  @@index([mobile])
  @@index([status])
  @@index([roleId])
}

model MandalDocument {
  id        Int      @id @default(autoincrement())
  mandalId  Int
  type      String   @db.VarChar(100)
  fileUrl   String   @db.Text
  fileId    String   @db.VarChar(255)
  createdAt DateTime @default(now())

  mandal Mandal @relation(fields: [mandalId], references: [id], onDelete: Cascade)

  @@index([mandalId])
  @@index([type])
}

model OTP {
  id          Int      @id @default(autoincrement())
  mobile      String   @db.VarChar(10)
  code        String   @db.VarChar(6)
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([mobile, code])
  @@index([mobile])
  @@index([expiresAt])
}

model Interest {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  @@index([name])
}

model HomeLocation {
  userId    Int      @id
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  area      String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomePost {
  id          Int              @id @default(autoincrement())
  authorId    Int
  mandalId    Int
  eventId     Int?
  text        String           @db.Text
  topic       String?          @db.VarChar(100)
  voice       String?          @db.VarChar(100)
  city        String           @db.VarChar(100)
  state       String           @db.VarChar(100)
  status      String           @default("PUBLISHED") @db.VarChar(20)
  visibility  String           @default("PUBLIC") @db.VarChar(20)
  publishedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mandal      Mandal           @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  event       HomeEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  media       HomeMedia[]
  likes       HomeLike[]
  saves       HomeSave[]
  comments    HomeComment[]
  reports     HomeReport[]
  impressions HomeImpression[]

  @@index([city, state, status, publishedAt, id])
  @@index([mandalId, status, publishedAt, id])
}

model HomeMedia {
  id         String      @id @default(uuid())
  ownerId    Int
  postId     Int?
  status     String      @default("PENDING") @db.VarChar(20)
  mimeType   String      @db.VarChar(100)
  width      Int?
  height     Int?
  bytes      Int?
  variants   Json?
  sourcePath String?     @db.Text
  attempts   Int         @default(0)
  leaseUntil DateTime?
  leaseToken String?     @db.VarChar(40)
  createdAt  DateTime    @default(now())
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post       HomePost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  events     HomeEvent[]
  stories    HomeStory[]

  @@index([status, leaseUntil, createdAt])
}

model HomeLike {
  postId Int
  userId Int
  post   HomePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model HomeSave {
  postId Int
  userId Int
  post   HomePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model HomeComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int
  text      String   @db.VarChar(2000)
  status    String   @default("PUBLISHED") @db.VarChar(20)
  createdAt DateTime @default(now())
  post      HomePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, status, id])
}

model HomeEvent {
  id             Int               @id @default(autoincrement())
  mandalId       Int
  title          String            @db.VarChar(200)
  description    String            @db.Text
  venue          String            @db.VarChar(255)
  city           String            @db.VarChar(100)
  state          String            @db.VarChar(100)
  category       String            @db.VarChar(100)
  mediaId        String?           @db.VarChar(40)
  startsAt       DateTime
  endsAt         DateTime
  status         String            @default("PUBLISHED") @db.VarChar(20)
  promotionStart DateTime?
  promotionEnd   DateTime?
  priority       Int               @default(0)
  mandal         Mandal            @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  posts          HomePost[]
  media          HomeMedia?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  participants   HomeParticipant[]

  @@index([city, state, status, endsAt])
  @@index([mandalId])
}

model HomeParticipant {
  eventId Int
  userId  Int
  event   HomeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model HomeStory {
  id        Int             @id @default(autoincrement())
  mandalId  Int
  mediaId   String          @db.VarChar(40)
  status    String          @default("PUBLISHED") @db.VarChar(20)
  createdAt DateTime        @default(now())
  expiresAt DateTime
  mandal    Mandal          @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  seen      HomeStorySeen[]
  media     HomeMedia       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mandalId, status, expiresAt])
}

model HomeStorySeen {
  storyId Int
  userId  Int
  seenAt  DateTime  @default(now())
  story   HomeStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

model HomeFilter {
  userId   Int
  targetId Int
  kind     String @db.VarChar(10)
  user     User   @relation("FilterOwner", fields: [userId], references: [id], onDelete: Cascade)
  target   User   @relation("FilterTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([userId, targetId, kind])
  @@index([targetId, kind])
}

model HomeReport {
  postId    Int
  userId    Int
  reason    String   @db.VarChar(500)
  createdAt DateTime @default(now())
  post      HomePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model HomeImpression {
  postId    Int
  userId    Int
  day       String   @db.VarChar(10)
  createdAt DateTime @default(now())
  post      HomePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, day])
  @@index([createdAt])
  @@index([userId])
}

model HomeSnapshot {
  id          String   @id @default(uuid())
  userId      Int
  locationKey String   @db.VarChar(255)
  postIds     Json
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

enum IssueStatus {
  PENDING
  RESOLVED
}

enum IssueParticipantRole {
  MEMBER
  APPROVER
  RESOLVER
}

enum IssueUploadPurpose {
  ISSUE
  COMMENT
  RESOLUTION
}

model Issue {
  id                   Int                @id @default(autoincrement())
  mandalId             Int
  createdByUserId      Int
  title                String             @db.VarChar(200)
  description          String             @db.Text
  locationOrMandalName String             @db.VarChar(255)
  pincode              String             @db.VarChar(10)
  occurrenceDate       DateTime
  publishedAt          DateTime           @default(now())
  status               IssueStatus        @default(PENDING)
  resolvedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  archivedAt           DateTime?
  publicationKey       String             @db.VarChar(100)
  publicationHash      String             @db.VarChar(64)
  mandal               Mandal             @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  creator              User               @relation(fields: [createdByUserId], references: [id])
  attachments          IssueAttachment[]
  participants         IssueParticipant[]
  supporters           IssueSupporter[]
  comments             IssueComment[]
  resolution           IssueResolution?
  activity             IssueActivity[]
  reads                IssueRead[]

  @@unique([mandalId, createdByUserId, publicationKey])
  @@index([mandalId, archivedAt, status, publishedAt, id])
  @@index([mandalId, archivedAt, publishedAt, id])
  @@index([pincode, archivedAt, status, publishedAt, id])
  @@index([createdByUserId, publishedAt])
}

model IssueUpload {
  id                   String                     @id @default(uuid()) @db.VarChar(36)
  mandalId             Int
  ownerId              Int
  purpose              IssueUploadPurpose
  mimeType             String                     @db.VarChar(30)
  bytes                Int
  width                Int
  height               Int
  fileId               String                     @db.VarChar(255)
  filePath             String                     @db.Text
  state                String                     @default("READY") @db.VarChar(20)
  createdAt            DateTime                   @default(now())
  expiresAt            DateTime
  mandal               Mandal                     @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  owner                User                       @relation(fields: [ownerId], references: [id])
  issueAttachment      IssueAttachment?
  commentAttachment    IssueCommentAttachment?
  resolutionAttachment IssueResolutionAttachment?

  @@index([state, expiresAt])
  @@index([ownerId, mandalId])
}

model IssueAttachment {
  id       Int         @id @default(autoincrement())
  issueId  Int
  uploadId String      @unique @db.VarChar(36)
  issue    Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  upload   IssueUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([issueId, id])
}

model IssueParticipant {
  issueId   Int
  memberId  Int
  role      IssueParticipantRole @default(MEMBER)
  createdAt DateTime             @default(now())
  issue     Issue                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  member    MandalMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([issueId, memberId, role])
  @@index([memberId, role])
}

model IssueSupporter {
  issueId   Int
  userId    Int
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@id([issueId, userId])
  @@index([userId, createdAt])
  @@index([issueId, createdAt, userId])
}

model IssueComment {
  id          Int                      @id @default(autoincrement())
  issueId     Int
  userId      Int
  text        String                   @db.VarChar(2000)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  issue       Issue                    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User                     @relation(fields: [userId], references: [id])
  attachments IssueCommentAttachment[]

  @@index([issueId, createdAt, id])
  @@index([userId, issueId])
}

model IssueCommentAttachment {
  id        Int          @id @default(autoincrement())
  commentId Int
  uploadId  String       @unique @db.VarChar(36)
  comment   IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  upload    IssueUpload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([commentId, id])
}

model IssueResolution {
  id               Int                         @id @default(autoincrement())
  issueId          Int                         @unique
  resolvedByUserId Int
  resolutionDate   DateTime
  description      String                      @db.Text
  submissionKey    String                      @db.VarChar(100)
  submissionHash   String                      @db.VarChar(64)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  issue            Issue                       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  resolver         User                        @relation(fields: [resolvedByUserId], references: [id])
  attachments      IssueResolutionAttachment[]

  @@index([resolvedByUserId])
}

model IssueResolutionAttachment {
  id           Int             @id @default(autoincrement())
  resolutionId Int
  uploadId     String          @unique @db.VarChar(36)
  resolution   IssueResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  upload       IssueUpload     @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([resolutionId, id])
}

model IssueActivity {
  id        Int      @id @default(autoincrement())
  issueId   Int
  userId    Int
  action    String   @db.VarChar(40)
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, issueId, createdAt])
  @@index([issueId, createdAt])
}

model IssueRead {
  issueId        Int
  userId         Int
  commentsReadAt DateTime
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@id([issueId, userId])
  @@index([userId])
}
