# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly declare text files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.pdf binary
